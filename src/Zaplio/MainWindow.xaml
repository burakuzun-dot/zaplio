                                <Setter Property="Padding" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:VirtualizingTilePanel Loaded="OnVodPanelLoaded" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Resources>
                            <!-- Top level: poster tiles in a grid -->
                            <DataTemplate x:Key="VodTileTemplate">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="Poster" CornerRadius="10" Background="{StaticResource Active}">
                                        <Grid>
                                            <Grid.Clip>
                                                <MultiBinding Converter="{x:Static local:RoundedClipConverter.Instance}" ConverterParameter="10">
