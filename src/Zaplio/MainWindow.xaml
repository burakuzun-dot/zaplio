                                                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.History}" FontSize="17" />
                                                        <TextBlock x:Name="VodWatchlistText" Text="Sonra izle" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock x:Name="VodPreviewError" Visibility="Collapsed" Foreground="{StaticResource Error}"
                                                       TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <local:TelevisionEffect x:Name="ChannelStatic" Visibility="Collapsed" IsHitTestVisible="False" Margin="8" />
                        <views:EmptyLibraryView x:Name="EmptyLibrary" Visibility="Collapsed" AddPlaylistRequested="OnEmptyLibraryAdd" />
                        <views:ChannelSleepingView x:Name="SleepingView" RetryRequested="OnSleepingRetry" NextChannelRequested="OnSleepingNext" />
                        <Border x:Name="MainVideoSlot" Margin="8">
                            <local:PlaybackView x:Name="VideoView" Visibility="Hidden">
                                <Grid x:Name="VideoOverlay" Background="#02000000" PreviewKeyDown="OnWindowKeyDown" AllowDrop="True"
                                      DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop" MouseLeftButtonDown="OnVideoMouseDown"
                                      MouseMove="OnVideoMouseMove" MouseLeftButtonUp="OnVideoMouseUp" MouseWheel="OnVideoMouseWheel">
                                    <local:TelevisionEffect x:Name="VideoStatic" Visibility="Collapsed" IsHitTestVisible="False" />
                                    <!-- Holds the last frame while a stream restarts for recording, so the picture never goes black. -->
                                    <Border x:Name="FreezeFrameHost" Background="Black" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Image x:Name="FreezeFrame" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Border x:Name="PlayPauseFlash" Width="92" Height="92" CornerRadius="46" Background="#B0121621" Visibility="Collapsed"
