<Window x:Class="Zaplio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:controls="clr-namespace:Zaplio.Controls"
        xmlns:views="clr-namespace:Zaplio.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zaplio" Icon="Assets/Zaplio.ico" Width="1380" Height="830" MinWidth="950" MinHeight="590"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnWindowKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="24" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="AmbientPanelSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=AmbientLightPanel}" Value="Visible">
                    <Setter Property="Background" Value="#60121621" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AmbientCanvasSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Canvas}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=AmbientLightPanel}" Value="Visible">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowLayout" Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="AmbientLightPanel" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.42">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="AmbientLeft" Color="Transparent" />
                    <GradientStop x:Name="AmbientRight" Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="TitleBar" Style="{StaticResource AmbientPanelSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleMouseDown">
            <Grid Height="66" Margin="21,0,11,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/Brand/zaplio-128.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Zaplio" />
                    <TextBlock Text="Zaplio" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Canvas}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="19" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LiveTab" IsChecked="True" GroupName="Library" Content="Canlı TV"
                                     Style="{StaticResource LibraryTab}" Checked="OnLibraryChanged" />
                        <RadioButton x:Name="MoviesTab" GroupName="Library" Content="Filmler"
                                     Style="{StaticResource LibraryTab}" Checked="OnLibraryChanged" />
                        <RadioButton x:Name="SeriesTab" GroupName="Library" Content="Diziler"
                                     Style="{StaticResource LibraryTab}" Checked="OnLibraryChanged" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Width="154" Margin="0,0,10,0">
                        <TextBlock Text="AKTİF KAYNAK" Style="{StaticResource SectionLabel}" FontSize="9" Margin="2,0,0,3" />
                        <ComboBox x:Name="ActiveSourcePicker" Style="{StaticResource LibraryPicker}" DisplayMemberPath="Name" Height="32"
                                  SelectionChanged="OnActiveSourceChanged" AutomationProperties.Name="Aktif kaynak" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Click="OnRefresh" ToolTip="Listeleri yenile"
                            AutomationProperties.Name="Listeleri yenile" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Refresh}" />
                    </Button>
                    <Button x:Name="SourceButton" Click="OnSources" Margin="0,0,5,0" AutomationProperties.Name="Yayın kaynakları">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Add}" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock Text="Kaynaklar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="OnSettings" Margin="0,0,8,0"
                            ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Settings}" />
                    </Button>
                    <Button x:Name="WatchHistoryButton" Style="{StaticResource IconButton}" Click="OnWatchHistory" ToolTip="İzleme geçmişi"
                            AutomationProperties.Name="İzleme geçmişi">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.History}" />
                    </Button>
                    <Border Width="1" Height="22" Background="{StaticResource Line}" Margin="0,0,7,0" />
                    <Button Style="{StaticResource WindowButton}" Click="OnMinimize" ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Minimize}" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnMaximize" ToolTip="Ekranı kapla / geri yükle" AutomationProperties.Name="Ekranı kapla veya geri yükle">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Maximize}" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnClose" ToolTip="Kapat" AutomationProperties.Name="Kapat">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationWidth" Width="218" />
                <ColumnDefinition x:Name="ChannelWidth" Width="318" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NavigationPane" Style="{StaticResource AmbientPanelSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="14,24,13,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="KÜTÜPHANE" Style="{StaticResource SectionLabel}" Margin="10,0,0,13" />
                    <ListBox x:Name="GroupList" Grid.Row="1" SelectionChanged="OnGroupChanged" AutomationProperties.Name="Kanal kategorileri"
                             ContextMenuOpening="OnGroupMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="23">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="17"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                               FontSize="11" Margin="7,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="AccountCard" Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="9" Padding="10,9" Margin="0,10,0,0" MouseLeftButtonUp="OnAccountCardClick"
                            ToolTipService.InitialShowDelay="300">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource GlyphFont}" Text="{x:Static local:IconGlyphs.Server}"
                                       FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SourceCount" Text="Kaynak yok" Style="{StaticResource MutedText}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AccountText" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ChannelPane" Grid.Column="1" Style="{StaticResource AmbientCanvasSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="15,20,14,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ChannelHeading" Text="Tüm kanallar" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="7" Padding="7,3" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="ChannelCount" Text="0" Style="{StaticResource MutedText}" FontSize="11" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="2,0,2,12">
                        <TextBox x:Name="SearchBox" Padding="36,8,42,8" TextChanged="OnSearchChanged" AutomationProperties.Name="Kanal ara" />
                        <TextBlock FontFamily="{StaticResource GlyphFont}" Text="{x:Static local:IconGlyphs.Search}" Foreground="{StaticResource Muted}" FontSize="16"
                                   Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Kanal ara" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,3" CornerRadius="4"
                                Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Ctrl+F" FontSize="10" Style="{StaticResource MutedText}" />
                        </Border>
                        <Button HorizontalAlignment="Right" Margin="0,0,5,0" Width="30" Height="28" MinHeight="28"
                                Click="OnClearSearch" ToolTip="Aramayı temizle" AutomationProperties.Name="Aramayı temizle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="15" />
                        </Button>
                    </Grid>
                    <ListBox x:Name="ChannelList" Grid.Row="2" SelectionChanged="OnChannelSelected" MouseLeftButtonUp="OnChannelClick"
                             PreviewKeyDown="OnChannelKeyDown" AutomationProperties.Name="Kanallar"
                             ContextMenuOpening="OnChannelMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#292744" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeTone}" Value="1">
                                                        <Setter Property="Background" Value="#26364C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeTone}" Value="2">
                                                        <Setter Property="Background" Value="#1F373B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeTone}" Value="3">
                                                        <Setter Property="Background" Value="#392A40" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Accent}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=ChannelLogo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border CornerRadius="9" Background="{StaticResource Surface}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=ChannelLogo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image x:Name="ChannelLogo" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       local:LogoLoader.Url="{Binding Logo}" local:LogoLoader.DecodeWidth="76" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,3,0,0">
                                            <Border DockPanel.Dock="Left" Background="{StaticResource Active}" CornerRadius="4" Padding="5,0,5,1"
                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="Bu kanalın birden fazla kalitesi var; sağ tıkla → Kalite / yayın">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                            </Border>
                                            <TextBlock Text="{Binding GroupLabel}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                    <controls:FavoriteBadge HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,-3"
                                                            IsFavorite="{Binding Converter={x:Static local:ChannelFavoriteConverter.Instance}, Mode=OneWay}"
                                                            CutoutBrush="{StaticResource Panel}" />
                                    <Viewbox Grid.Column="2" Width="32" Height="32" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <controls:FavoriteToggle ChannelName="{Binding Name}"
                                                                 IsFavorite="{Binding Converter={x:Static local:ChannelFavoriteConverter.Instance}, Mode=OneWay}"
                                                                 FavoriteToggled="OnRowFavoriteToggled" />
                                    </Viewbox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoChannels" Grid.Row="2" Text="Henüz kanal yok." Style="{StaticResource MutedText}" Margin="8,10,8,0"
                               TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border x:Name="VodPane" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource AmbientCanvasSurface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="19,20,17,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="VodBack" Content="Diziler" Click="OnVodBack" Visibility="Collapsed" Margin="0,0,10,0" />
                        <Button x:Name="VodDetailsButton" DockPanel.Dock="Right" Content="Detaylar" Click="OnVodDetails"
                                IsEnabled="False" Margin="10,0,0,0" />
                        <TextBlock x:Name="VodCount" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock x:Name="VodHeading" Text="Filmler" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ComboBox x:Name="VodCategoryPicker" Grid.Row="1" Margin="0,0,0,10" DisplayMemberPath="Label" Style="{StaticResource LibraryPicker}"
                              SelectionChanged="OnVodFilterChanged" AutomationProperties.Name="İçerik kategorisi" />
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="VodSearchBox" Padding="36,8,10,8" TextChanged="OnVodSearchChanged" AutomationProperties.Name="İçerik ara" />
                        <TextBlock FontFamily="{StaticResource GlyphFont}" Text="{x:Static local:IconGlyphs.Search}" Foreground="{StaticResource Muted}"
                                   FontSize="16" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="İçerik ara" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=VodSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox x:Name="VodList" Grid.Row="3" PreviewKeyDown="OnVodKeyDown"
                             SelectionChanged="OnVodSelected" AutomationProperties.Name="Xtream içerikleri">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Setter Property="Padding" Value="9,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="47" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="54" HorizontalAlignment="Left" Background="{StaticResource Active}" CornerRadius="7"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Tile}" FontFamily="{StaticResource GlyphFont}" Foreground="{StaticResource Accent}"
                                                       FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                   local:LogoLoader.Url="{Binding Item.Poster}" local:LogoLoader.DecodeWidth="96">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,38,54" RadiusX="7" RadiusY="7" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="VodEmpty" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22,8">
                        <TextBlock Text="{x:Static local:IconGlyphs.Movie}" FontFamily="{StaticResource GlyphFont}" Foreground="{StaticResource Accent}"
                                   FontSize="36" HorizontalAlignment="Center" />
                        <TextBlock x:Name="VodMessage" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,0" />
                        <Button x:Name="VodConnect" Content="Xtream kaynağı ekle" Click="OnSources" HorizontalAlignment="Center" Margin="0,13,0,0" />
                        <Button x:Name="VodRetry" Content="Tekrar dene" Click="OnRefresh" HorizontalAlignment="Center" Margin="0,13,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="PlayerPane" Grid.Column="2" Margin="23,22,23,20" SizeChanged="OnGuideHostSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="PlayerHeader" Margin="1,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PlayerTitle" Text="Canlı TV" FontSize="29" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlayerSubtitle" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="GuideToggle" Grid.Column="1" Click="OnToggleGuide" Margin="7,0,8,0" Padding="9,5"
                            ToolTip="Yayın rehberi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Calendar}" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock x:Name="GuideToggleText" Text="Rehber" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavoriteButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="OnFavorite"
                            IsEnabled="False" ToolTip="Favorilere ekle" AutomationProperties.Name="Favorilere ekle">
                        <TextBlock x:Name="FavoriteIcon" Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Star}" FontSize="23" />
                    </Button>
                </Grid>

                <Border x:Name="VideoFrame" Grid.Row="1" CornerRadius="{StaticResource PlayerCornerRadius}" Background="Black"
                        BorderBrush="{StaticResource PlayerEdge}" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PlayerPlaceholder" CornerRadius="22" Margin="1">
                            <Border.Background>
                                <RadialGradientBrush Center="0.82,0.52" GradientOrigin="0.82,0.52" RadiusX="0.75" RadiusY="0.78">
                                    <GradientStop Color="#39295C" Offset="0" />
                                    <GradientStop Color="#211D39" Offset="0.53" />
                                    <GradientStop Color="#131625" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="1" Margin="-55,16,-55,16" Stretch="Uniform" IsHitTestVisible="False">
                                    <Canvas Width="400" Height="400">
                                        <Ellipse Canvas.Left="15" Canvas.Top="15" Width="370" Height="370" Stroke="#63528D" StrokeThickness="1" Opacity="0.40" />
