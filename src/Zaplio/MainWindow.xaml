                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                        <Button Click="OnPip" Background="#E6121621" Padding="10,4" MinHeight="30" FontSize="12"
                                                ToolTip="Normal pencereye dön (Esc veya çift tık)" AutomationProperties.Name="Normal pencereye dön">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Fullscreen}" FontSize="15" Margin="0,0,5,0" />
                                                <TextBlock Text="Büyüt" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnVodStop" Background="#E6121621" Padding="10,4" MinHeight="30" FontSize="12" Margin="4,0,0,0"
                                                ToolTip="Yayını durdur" AutomationProperties.Name="Yayını durdur">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Stop}" FontSize="15" Margin="0,0,5,0" />
                                                <TextBlock Text="Durdur" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <local:TelevisionEffect x:Name="VideoPowerOff" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1" />
                                </Grid>
                            </local:PlaybackView>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="PlayerControls" Grid.Row="2" SizeChanged="OnPlayerChromeSizeChanged" Background="{StaticResource PlayerControlsSurface}" BorderBrush="{StaticResource PlayerEdge}"
                        BorderThickness="1" CornerRadius="27" Padding="8,6" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlayButton" Click="OnPlayToggle" ToolTip="Oynat" Style="{StaticResource PlayerAction}"
                                AutomationProperties.Name="Oynat" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PlayIcon" Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Play}" FontSize="17" />
                                <TextBlock x:Name="PlayText" Text="Oynat" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="VodStop" Style="{StaticResource PlayerToolButton}" Visibility="Collapsed" Click="OnVodStop"
                                ToolTip="Durdur" AutomationProperties.Name="Durdur" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Stop}" FontSize="17" />
                        </Button>
                        </StackPanel>
                        <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,5,0">
                            <Ellipse x:Name="PlaybackLight" Width="6" Height="6" Fill="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PlaybackStatus" Text="Hazır" FontSize="12" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <Border Grid.Column="2" Grid.ColumnSpan="3" Height="38" VerticalAlignment="Center" CornerRadius="19" IsHitTestVisible="False"
                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                        <Button x:Name="MuteButton" Grid.Column="2" Click="OnMute" Style="{StaticResource BarButton}" Margin="3,0,0,0" ToolTip="Sesi kapat / aç"
                                AutomationProperties.Name="Sesi kapat veya aç">
                            <TextBlock x:Name="MuteIcon" Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Volume}" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Grid.Column="3" Width="67" Minimum="0" Maximum="100" Value="75" Style="{StaticResource VolumeSlider}"
                                VerticalAlignment="Center" ValueChanged="OnVolumeChanged" AutomationProperties.Name="Ses düzeyi" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button x:Name="NextEpisodeButton" Content="Sonraki bölüm" Click="OnNextEpisode" Visibility="Collapsed" Margin="8,0,0,0"
                                local:ButtonChrome.CornerRadius="18" />
                        <Button x:Name="LiveReturnButton" Content="Canlıya dön" Click="OnReturnToLive" Visibility="Collapsed" Margin="8,0,0,0" local:ButtonChrome.CornerRadius="18"
                                ToolTip="Canlı yayına geri dön (→)" AutomationProperties.Name="Canlıya dön" />
                        <Button x:Name="TracksButton" Style="{StaticResource BarButton}" ToolTip="Ses, altyazı ve görüntü seçenekleri" Click="OnTracks"
                                IsEnabled="False" Margin="8,0,0,0" AutomationProperties.Name="Ses, altyazı ve görüntü seçenekleri">
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Settings}" FontSize="17" />
                        </Button>
                        <Button x:Name="RecordButton" Click="OnRecord" Style="{StaticResource BarButton}" IsEnabled="False" Margin="2,0,0,0"
                                ToolTip="Kaydet: oynayanı kalitesini bozmadan kaydet (R)" AutomationProperties.Name="Kaydet">
                            <Grid Width="16" Height="16">
                                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                                <Ellipse x:Name="RecordDot" Width="8" Height="8" Fill="{StaticResource Muted}" />
                            </Grid>
                        </Button>
                        <Button x:Name="CinemaButton" Click="OnCinema" Style="{StaticResource BarButton}" IsEnabled="False" Margin="2,0,0,0"
                                ToolTip="Sinema modu: çevreyi karart (C)" AutomationProperties.Name="Sinema modu">
                            <TextBlock x:Name="CinemaIcon" Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Lightbulb}" FontSize="17" />
                        </Button>
                        <Button x:Name="PipButton" Click="OnPip" Style="{StaticResource BarButton}" IsEnabled="False" Margin="2,0,0,0"
                                ToolTip="Mini pencere (P)" AutomationProperties.Name="Mini pencere">
                            <Grid Width="15" Height="11">
                                <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.4" CornerRadius="2" />
                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="5" Height="4"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" CornerRadius="1" />
                            </Grid>
                        </Button>
                        <Button x:Name="SecondScreenButton" Click="OnSecondScreen" IsEnabled="False" Style="{StaticResource BarButton}" Margin="2,0,0,0" Visibility="Collapsed"
                                ToolTip="Yayını diğer monitörde tam ekran aç; liste ve rehber burada kalır (Shift+F11)"
                                AutomationProperties.Name="İkinci ekranda oynat">
                            <TextBlock x:Name="SecondScreenText" Text="2. ekran" />
                        </Button>
                        <Button x:Name="FullscreenButton" Click="OnFullscreen" Style="{StaticResource BarButton}" Margin="2,0,3,0"
                                ToolTip="Tam ekran (F11)" AutomationProperties.Name="Tam ekran">
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Fullscreen}" />
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="VodTimeline" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Margin="0,8,0,0" Padding="12,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VodElapsed" Text="00:00" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                        <Slider x:Name="VodSeek" Grid.Column="1" Margin="12,0" Style="{StaticResource SeekSlider}" SmallChange="5000" LargeChange="15000"
                                MouseMove="OnVodSeekHover" MouseLeave="OnVodSeekLeave"
                                IsEnabled="False" ValueChanged="OnVodSeekChanged"
                                LostMouseCapture="OnVodSeekEnd"
                                PreviewMouseWheel="OnVodSeekWheel" ToolTip="Sürükle: görüntü seninle kayar · Tekerlek: 5 sn (Shift: 1 sn)"
                                AutomationProperties.Name="Oynatma konumu" />
                        <TextBlock x:Name="VodDuration" Grid.Column="2" Text="—" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border x:Name="GuideSummary" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,10,0,0" Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="NowProgramme" Margin="0,0,10,0">
                            <TextBlock Text="ŞİMDİ" Foreground="{StaticResource LiveColor}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="NowProgrammeTitle" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="NextProgramme" Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock x:Name="NextProgrammeTime" Style="{StaticResource SectionLabel}" FontSize="10" />
                            <TextBlock x:Name="NextProgrammeTitle" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="GuidePane" Grid.Row="4" Height="240" Margin="0,10,0,0" Visibility="Collapsed"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15">
                    <Grid Margin="15,8,15,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="GuidePrevious" Style="{StaticResource IconButton}" Click="OnGuidePrevious"
                                        ToolTip="Önceki gün" AutomationProperties.Name="Önceki gün">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.ChevronLeft}" />
                                </Button>
                                <TextBlock x:Name="GuideDayLabel" Text="Bugün" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="4,0" />
                                <Button x:Name="GuideNext" Style="{StaticResource IconButton}" Click="OnGuideNext"
                                        ToolTip="Sonraki gün" AutomationProperties.Name="Sonraki gün">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.ChevronRight}" />
                                </Button>
                                <TextBlock x:Name="GuideChannelName" Style="{StaticResource MutedText}" MaxWidth="92"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="GuidePlay" Style="{StaticResource IconButton}" Click="OnGuidePlay"
                                        ToolTip="Kanalı oynat" AutomationProperties.Name="Kanalı oynat">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Play}" FontSize="17" />
                                </Button>
                                <Button x:Name="GuideReload" Style="{StaticResource IconButton}" Click="OnGuideReload"
                                        ToolTip="Rehberi yenile" AutomationProperties.Name="Rehberi yenile">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Refresh}" />
                                </Button>
                                <Button x:Name="GuideSource" Style="{StaticResource IconButton}" Click="OnGuideSource"
                                        ToolTip="XMLTV kaynağını ayarla" AutomationProperties.Name="XMLTV kaynağını ayarla">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Settings}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="OnToggleGuide"
                                        ToolTip="Rehberi gizle" AutomationProperties.Name="Rehberi gizle">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                        <ListBox x:Name="GuideList" SelectionChanged="OnGuideProgrammeChanged" MouseDoubleClick="OnGuideRowDoubleClick"
                                 AutomationProperties.Name="Günün yayın programı">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartTime}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Accent}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" Background="#213735" CornerRadius="6" Padding="6,4" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="YAYINDA" Foreground="{StaticResource LiveColor}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource Active}" CornerRadius="6" Padding="6,4" VerticalAlignment="Center"
                                                ToolTip="Arşivden izlenebilir · çift tıkla">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowArchive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="ARŞİV" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="GuideDetails" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                                Margin="8,0,0,0" Padding="11,4,0,3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Accent}" FontSize="11" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,5" />
                                    <TextBlock x:Name="GuideDescription" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <StackPanel x:Name="GuideEmpty" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2">
                            <TextBlock x:Name="GuideMessage" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap"
                                       TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="GuideConnect" Content="XMLTV kaynağı ekle" Click="OnGuideSource" HorizontalAlignment="Center"
                                    Margin="0,7,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Under the capped player while browsing movies and series: facts of the selection, next episodes, continue watching. -->
            <Border x:Name="VodInfoPanel" Grid.Column="2" VerticalAlignment="Top" Margin="22,0,22,16" Visibility="Collapsed"
                    AutomationProperties.Name="Ayrıntılar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="VodInfoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="2,0,6,0">
                            <TextBlock x:Name="VodInfoHeading" Text="Hakkında" Style="{StaticResource SectionLabel}" FontSize="13" Margin="0,0,0,8" />
                            <TextBlock x:Name="VodInfoHint" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" />
                            <ItemsControl x:Name="VodInfoChips" Focusable="False" Margin="0,0,0,2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9"
                                                Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="VodInfoPlot" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <Grid x:Name="VodInfoCredits" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="VodInfoDirectorLabel" Text="Yönetmen" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,12,4" />
                                <TextBlock x:Name="VodInfoDirector" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="VodInfoCastLabel" Grid.Row="1" Text="Oyuncular" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,12,0" />
                                <TextBlock x:Name="VodInfoCast" Grid.Row="1" Grid.Column="1" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel x:Name="VodNextEpisodesPanel" Margin="0,14,0,0">
                                <TextBlock Text="Sıradaki bölümler" Style="{StaticResource SectionLabel}" FontSize="13" Margin="0,0,0,6" />
                                <ItemsControl x:Name="VodNextEpisodes" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="OnNextEpisodeRow" Cursor="Hand" Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Frame" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                                CornerRadius="10" Padding="10,7">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Hover}" />
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ActiveLine}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Play}" FontSize="13"
                                                               Foreground="{StaticResource Accent}" Margin="0,0,9,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Item.Detail}" Style="{StaticResource MutedText}" FontSize="12"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="ContinueHostInfo" Grid.Row="1" SizeChanged="OnContinueHostInfoSizeChanged" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="Footer" Grid.Row="2" Style="{StaticResource AmbientPanelSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,6,8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Style="{StaticResource MutedText}" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource TextButton}" Click="OnUpdate" Visibility="Collapsed"
                        Margin="0,0,8,0">
                    <TextBlock x:Name="UpdateText" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="12" />
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel x:Name="StabilityPanel" Orientation="Horizontal" Visibility="Collapsed" Background="Transparent"
                                Margin="0,0,16,0" ToolTipService.InitialShowDelay="200">
                        <Ellipse x:Name="StabilityLight" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StabilityText" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="Bilgisayarın anlık toplam indirme ve yükleme hızı">
                        <TextBlock Text="↓" FontSize="12" Foreground="{StaticResource LiveColor}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="DownloadSpeed" Text="—" Style="{StaticResource MutedText}" FontSize="11" MinWidth="64" VerticalAlignment="Center" />
                        <TextBlock Text="↑" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,4,0" />
                        <TextBlock x:Name="UploadSpeed" Text="—" Style="{StaticResource MutedText}" FontSize="11" MinWidth="64" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <local:TelevisionEffect x:Name="WindowPowerOff" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1" />
        <views:OfflineView x:Name="OfflineView" Grid.RowSpan="3" Panel.ZIndex="2" RetryRequested="OnOfflineRetry" ConnectionRestored="OnOfflineRetry" />
        <!-- Shown while a video file is dragged over the window. -->
        <Border x:Name="DropHint" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Background="#EE070910">
            <Border Margin="40" CornerRadius="24" BorderThickness="2" BorderBrush="{DynamicResource ZpBoltBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{DynamicResource ZpBoltIcon}" Fill="{DynamicResource ZpBoltBrush}" Width="46" Height="46" Stretch="Uniform" />
                    <TextBlock x:Name="DropHintText" Text="Bırak, hemen oynasın" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Video, klasör ya da altyazı dosyası. Dosyalar bilgisayarından çıkmaz." Style="{StaticResource MutedText}"
                               FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
