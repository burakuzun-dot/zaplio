                                                    <Binding ElementName="Poster" Path="ActualHeight" />
                                                </MultiBinding>
                                            </Grid.Clip>
                                            <TextBlock Text="{Binding Tile}" FontFamily="{StaticResource GlyphFont}" Foreground="{StaticResource Accent}"
                                                       FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                   local:LogoLoader.Url="{Binding Item.Poster}" local:LogoLoader.DecodeWidth="200" />
                                        </Grid>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Width="34" Height="34" CornerRadius="17"
                                            Background="#D9121621">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsFavorite, ElementName=VodTileFavorite}" Value="False" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Opacity" Value="0" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Viewbox Width="30" Height="30">
                                            <controls:FavoriteToggle x:Name="VodTileFavorite" IsChannel="False" ChannelName="{Binding Title}"
                                                                     IsFavorite="{Binding IsFavorite, Mode=OneWay}" FavoriteToggled="OnVodRowFavoriteToggled" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="2,7,2,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                            <!-- Inside a series: one row per episode -->
                            <DataTemplate x:Key="VodRowTemplate">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="47" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="54" HorizontalAlignment="Left" Background="{StaticResource Active}" CornerRadius="7"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Tile}" FontFamily="{StaticResource GlyphFont}" Foreground="{StaticResource Accent}"
                                                       FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                   local:LogoLoader.Url="{Binding Item.Poster}" local:LogoLoader.DecodeWidth="96">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,38,54" RadiusX="7" RadiusY="7" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <controls:FavoriteBadge HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,-3"
                                                            IsFavorite="{Binding IsFavorite, Mode=OneWay}" CutoutBrush="{StaticResource Canvas}" />
                                    <Viewbox Grid.Column="2" Width="32" Height="32" VerticalAlignment="Center">
                                        <Viewbox.Style>
                                            <Style TargetType="Viewbox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanFavorite}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsFavorite, ElementName=VodRowFavorite}" Value="False" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Opacity" Value="0" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Viewbox.Style>
                                        <controls:FavoriteToggle x:Name="VodRowFavorite" IsChannel="False" ChannelName="{Binding Title}"
                                                                 IsFavorite="{Binding IsFavorite, Mode=OneWay}" FavoriteToggled="OnVodRowFavoriteToggled" />
                                    </Viewbox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.Resources>
                        <ListBox.ItemTemplateSelector>
                            <local:VodTemplateSelector Tile="{StaticResource VodTileTemplate}" Row="{StaticResource VodRowTemplate}" />
                        </ListBox.ItemTemplateSelector>
                    </ListBox>
                    <local:SkeletonList x:Name="VodSkeleton" Grid.Row="5" Visibility="Collapsed" Posters="True" Text="İçerikler yükleniyor…" />
                    <StackPanel x:Name="VodEmpty" Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22,8">
                        <TextBlock Text="{x:Static local:IconGlyphs.Movie}" FontFamily="{StaticResource GlyphFont}" Foreground="{StaticResource Accent}"
                                   FontSize="36" HorizontalAlignment="Center" />
                        <TextBlock x:Name="VodMessage" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,0" />
                        <Button x:Name="VodConnect" Content="Xtream kaynağı ekle" Click="OnSources" HorizontalAlignment="Center" Margin="0,13,0,0" />
                        <Button x:Name="VodRetry" Content="Tekrar dene" Click="OnRefresh" HorizontalAlignment="Center" Margin="0,13,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="PlayerPane" Grid.Column="2" Margin="22,20,22,16" SizeChanged="OnPlayerPaneSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="PlayerHeader" Margin="1,0,0,17" SizeChanged="OnPlayerChromeSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PlayerTitle" Text="Canlı TV" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlayerSubtitle" Style="{StaticResource MutedText}" FontSize="13" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="GuideGridButton" Click="OnGuideGrid" Margin="7,0,0,0" Padding="12,0" MinHeight="38" local:ButtonChrome.CornerRadius="12"
                                ToolTip="Bu listedeki tüm kanalların yayın rehberi: kanallar satır, saatler sütun"
                                AutomationProperties.Name="Tüm kanalların yayın rehberi"
                                Visibility="{Binding Visibility, ElementName=GuideToggle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Television}" FontSize="17" Margin="0,0,6,0" />
                                <TextBlock x:Name="GuideGridText" Text="Tüm rehber" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GuideToggle" Click="OnToggleGuide" Margin="7,0,8,0" Padding="12,0" MinHeight="38" local:ButtonChrome.CornerRadius="12"
                                ToolTip="Seçili kanalın yayın rehberi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Calendar}" FontSize="17" Margin="0,0,6,0" />
                                <TextBlock x:Name="GuideToggleText" Text="Rehber" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button x:Name="HeaderWatchlistButton" Grid.Column="1" Click="OnHeaderWatchlist" Margin="7,0,8,0" Padding="12,0" MinHeight="38"
                            local:ButtonChrome.CornerRadius="12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.History}" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock x:Name="HeaderWatchlistText" Text="Sonra izle" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="FavoriteButton" Grid.Column="2" Width="38" Height="38" CornerRadius="12" BorderThickness="1"
                            Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" IsEnabled="False">
                        <Viewbox Width="36" Height="36">
                            <controls:FavoriteToggle x:Name="HeaderFavorite" FavoriteToggled="OnHeaderFavoriteToggled" />
                        </Viewbox>
                    </Border>
                </Grid>

                <Border x:Name="VideoFrame" Grid.Row="1" CornerRadius="{StaticResource PlayerCornerRadius}" Background="Black"
                        BorderBrush="{StaticResource PlayerEdge}" BorderThickness="1">
                    <!-- Rounded clip: opaque overlays (first list, sleeping channel) must not paint over the frame's corners. -->
                    <Grid x:Name="VideoFrameContent">
                        <Grid.Clip>
                            <MultiBinding Converter="{x:Static local:RoundedClipConverter.Instance}" ConverterParameter="23">
                                <Binding ElementName="VideoFrameContent" Path="ActualWidth" />
                                <Binding ElementName="VideoFrameContent" Path="ActualHeight" />
                            </MultiBinding>
                        </Grid.Clip>
                        <Border x:Name="PlayerPlaceholder" CornerRadius="22" Margin="1">
                            <Border.Background>
                                <RadialGradientBrush Center="0.82,0.52" GradientOrigin="0.82,0.52" RadiusX="0.75" RadiusY="0.78">
                                    <GradientStop Color="#39295C" Offset="0" />
                                    <GradientStop Color="#211D39" Offset="0.53" />
                                    <GradientStop Color="#131625" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <local:AuroraBackground Grid.ColumnSpan="2" />
                                <Viewbox Grid.Column="1" Margin="-55,16,-55,16" Stretch="Uniform" IsHitTestVisible="False">
                                    <Canvas Width="400" Height="400">
                                        <Ellipse Canvas.Left="15" Canvas.Top="15" Width="370" Height="370" Stroke="#63528D" StrokeThickness="1" Opacity="0.40" />
                                        <Ellipse Canvas.Left="46" Canvas.Top="46" Width="308" Height="308" Stroke="#7461A6" StrokeThickness="1" StrokeDashArray="2,6" Opacity="0.75" />
                                        <Ellipse Canvas.Left="77" Canvas.Top="77" Width="246" Height="246" Stroke="#8773C5" StrokeThickness="1.4" Opacity="0.60" />
                                        <Ellipse Canvas.Left="106" Canvas.Top="106" Width="188" Height="188" Stroke="#A38CDE" StrokeThickness="1.4" Opacity="0.65" />
                                        <Path Data="M200,15 V107 M200,293 V385 M15,200 H107 M293,200 H385"
                                              Stroke="#75659F" StrokeDashArray="2,5" StrokeThickness="1" Opacity="0.75" />
                                        <Ellipse Canvas.Left="90" Canvas.Top="125" Width="7" Height="7" Fill="#B4A3EF" />
                                        <Ellipse Canvas.Left="307" Canvas.Top="263" Width="10" Height="10" Fill="#CDBDFE" />
                                        <Ellipse Canvas.Left="269" Canvas.Top="38" Width="6" Height="6" Fill="#8F79C7" />
                                        <Ellipse Canvas.Left="71" Canvas.Top="294" Width="5" Height="5" Fill="#7964B1" />
                                        <Border Canvas.Left="138" Canvas.Top="138" Width="124" Height="124" Background="#422F67"
                                                BorderBrush="#8E79C4" BorderThickness="1.5" CornerRadius="33">
                                            <TextBlock Text="{x:Static local:IconGlyphs.Live}" FontFamily="{StaticResource GlyphFont}"
                                                       Foreground="{StaticResource Accent}" FontSize="64"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Margin="29,24,0,24" MaxWidth="345" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="PlaceholderTitle" Text="İlk kaynağını ekle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PlaceholderDescription" Text="M3U listeni veya Xtream hesabını bağla." Style="{StaticResource MutedText}"
                                               FontSize="14" Margin="0,9,0,0" TextWrapping="Wrap" />
                                    <Button x:Name="FirstSourceButton" Style="{StaticResource Primary}" Click="OnSources"
                                            HorizontalAlignment="Left" Margin="0,22,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static local:IconGlyphs.Add}" Style="{StaticResource Glyph}" FontSize="18" Margin="0,0,6,0" />
                                            <TextBlock Text="Kaynak ekle" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="VodPreviewPanel" Visibility="Collapsed" Margin="1" CornerRadius="22" ClipToBounds="True">
                            <Border.Background>
                                <RadialGradientBrush Center="0.9,0.20" GradientOrigin="0.9,0.20" RadiusX="0.64" RadiusY="0.95">
                                    <GradientStop Color="#302748" />
                                    <GradientStop Color="#17182B" Offset="0.58" />
                                    <GradientStop Color="#10121D" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border HorizontalAlignment="Right" Width="550" CornerRadius="0,22,22,0" IsHitTestVisible="False">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Source, ElementName=VodPreviewPoster}" Stretch="UniformToFill"
                                                    AlignmentX="Center" AlignmentY="Top" Opacity="0.39" />
                                    </Border.Background>
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" />
                                            <GradientStop Color="#64000000" Offset="0.40" />
                                            <GradientStop Color="Black" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border CornerRadius="22" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#0010121D" />
                                            <GradientStop Color="#4810121D" Offset="0.38" />
                                            <GradientStop Color="#EA10121D" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center" Padding="28,27">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MaxWidth="212" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="5*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource Active}" BorderBrush="{StaticResource ActiveLine}"
                                                BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                                            <Viewbox Stretch="Uniform">
