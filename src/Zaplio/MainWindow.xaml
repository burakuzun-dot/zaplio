<Window x:Class="Zaplio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:controls="clr-namespace:Zaplio.Controls"
        xmlns:views="clr-namespace:Zaplio.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zaplio" Icon="Assets/Zaplio.ico" Width="1380" Height="830" MinWidth="950" MinHeight="590"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnWindowKeyDown"
        AllowDrop="True" DragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="24" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="AmbientPanelSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=AmbientLightPanel}" Value="Visible">
                    <Setter Property="Background" Value="#A0121621" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AmbientCanvasSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Canvas}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=AmbientLightPanel}" Value="Visible">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowLayout" Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Sinema modu: under the ambient light, over the window background; the panels above it fade out. -->
        <Border x:Name="CinemaShade" Grid.RowSpan="3" Background="#030407" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed" />
        <Border x:Name="AmbientLightPanel" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.6">
            <local:AmbientGlow x:Name="AmbientGlow" />
        </Border>
        <Border x:Name="TitleBar" Style="{StaticResource AmbientPanelSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleMouseDown">
            <Grid Height="58" Margin="20,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/Brand/zaplio-128.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Zaplio" />
                    <TextBlock Text="Zaplio" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Border x:Name="LibraryTabs" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Canvas}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="21" Padding="4">
                    <Grid>
                        <Canvas ClipToBounds="True">
                            <Border x:Name="LibraryIndicator" Background="{StaticResource Active}" BorderBrush="{StaticResource ActiveLine}"
                                    BorderThickness="1" CornerRadius="{StaticResource LibraryNavigationTabRadius}" />
                        </Canvas>
                        <UniformGrid x:Name="LibraryTabsPanel" Rows="1">
                            <RadioButton x:Name="LiveTab" IsChecked="True" GroupName="Library" Content="Canlı TV"
                                         Style="{StaticResource LibraryNavigationTab}" Checked="OnLibraryChanged" />
                            <RadioButton x:Name="MoviesTab" GroupName="Library" Content="Filmler"
                                         Style="{StaticResource LibraryNavigationTab}" Checked="OnLibraryChanged" />
                            <RadioButton x:Name="SeriesTab" GroupName="Library" Content="Diziler"
                                         Style="{StaticResource LibraryNavigationTab}" Checked="OnLibraryChanged" />
                        </UniformGrid>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WatchHistoryButton" Style="{StaticResource IconButton}" Click="OnWatchHistory" ToolTip="İzleme geçmişi"
                            AutomationProperties.Name="İzleme geçmişi" Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.History}" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="OnSettings" Margin="0,0,8,0"
                            ToolTip="Ayarlar ve kaynaklar" AutomationProperties.Name="Ayarlar ve kaynaklar">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Settings}" />
                    </Button>
                    <Border Width="1" Height="22" Background="{StaticResource Line}" Margin="0,0,7,0" />
                    <Button Style="{StaticResource WindowButton}" Click="OnMinimize" ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Minimize}" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnMaximize" ToolTip="Ekranı kapla / geri yükle" AutomationProperties.Name="Ekranı kapla veya geri yükle">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Maximize}" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnClose" ToolTip="Kapat" AutomationProperties.Name="Kapat">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationWidth" Width="218" />
                <ColumnDefinition x:Name="ChannelWidth" Width="318" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NavigationPane" Style="{StaticResource AmbientPanelSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="12,20,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="KÜTÜPHANE" Style="{StaticResource SectionLabel}" Margin="10,4,0,12" />
                    <ListBox x:Name="GroupList" Grid.Row="1" SelectionChanged="OnGroupChanged" AutomationProperties.Name="Kanal kategorileri"
                             ContextMenuOpening="OnGroupMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="23">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}" FontSize="17"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label, Converter={x:Static local:CleanLabelConverter.Instance}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                               FontSize="11" Margin="7,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="ChannelPane" Grid.Column="1" Style="{StaticResource AmbientCanvasSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="16,20,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ChannelHeading" Text="Tüm kanallar" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="7" Padding="7,3" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="ChannelCount" Text="0" Style="{StaticResource MutedText}" FontSize="11" />
                        </Border>
                        <Button x:Name="LuckyLiveButton" Grid.Column="2" Margin="8,-6,0,-6" VerticalAlignment="Center" Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnLucky"
                                ToolTip="Şansıma: listeden rastgele bir kanal seç ve aç" AutomationProperties.Name="Şansıma">
                            <Path Data="{DynamicResource ZpBoltIcon}" Fill="{DynamicResource ZpBoltBrush}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="2,0,2,12">
                        <TextBox x:Name="SearchBox" Padding="36,8,42,8" TextChanged="OnSearchChanged" AutomationProperties.Name="Kanal ara" />
                        <TextBlock FontFamily="{StaticResource GlyphFont}" Text="{x:Static local:IconGlyphs.Search}" Foreground="{StaticResource Muted}" FontSize="16"
                                   Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Kanal ara" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,3" CornerRadius="4"
                                Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Ctrl+F" FontSize="10" Style="{StaticResource MutedText}" />
                        </Border>
                        <Button HorizontalAlignment="Right" Margin="0,0,5,0" Width="30" Height="28" MinHeight="28"
                                Click="OnClearSearch" ToolTip="Aramayı temizle" AutomationProperties.Name="Aramayı temizle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="15" />
                        </Button>
                    </Grid>
                    <ListBox x:Name="ChannelList" Grid.Row="2" SelectionChanged="OnChannelSelected" MouseLeftButtonUp="OnChannelClick"
                             PreviewKeyDown="OnChannelKeyDown" AutomationProperties.Name="Kanallar"
                             ContextMenuOpening="OnChannelMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#292744" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeTone}" Value="1">
                                                        <Setter Property="Background" Value="#26364C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeTone}" Value="2">
                                                        <Setter Property="Background" Value="#1F373B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeTone}" Value="3">
                                                        <Setter Property="Background" Value="#392A40" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Accent}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=ChannelLogo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border CornerRadius="10" Background="{StaticResource Surface}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=ChannelLogo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image x:Name="ChannelLogo" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       local:LogoLoader.Url="{Binding Logo}" local:LogoLoader.DecodeWidth="76" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,3,0,0">
                                            <Border DockPanel.Dock="Left" Background="{StaticResource Active}" CornerRadius="4" Padding="5,0,5,1"
                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="Bu kanalın birden fazla kalitesi var; sağ tıkla → Kalite / yayın">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                            </Border>
                                            <TextBlock Text="{Binding GroupLabel}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>
                                    <controls:FavoriteBadge HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,-3"
                                                            IsFavorite="{Binding Converter={x:Static local:ChannelFavoriteConverter.Instance}, Mode=OneWay}"
                                                            CutoutBrush="{StaticResource Panel}" />
                                    <Viewbox Grid.Column="2" Width="32" Height="32" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Viewbox.Style>
                                            <Style TargetType="Viewbox">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsFavorite, ElementName=RowFavorite}" Value="False" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Opacity" Value="0" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Viewbox.Style>
                                        <controls:FavoriteToggle x:Name="RowFavorite" ChannelName="{Binding Name}"
                                                                 IsFavorite="{Binding Converter={x:Static local:ChannelFavoriteConverter.Instance}, Mode=OneWay}"
                                                                 FavoriteToggled="OnRowFavoriteToggled" />
                                    </Viewbox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <local:SkeletonList x:Name="ChannelSkeleton" Grid.Row="2" Visibility="Collapsed" Text="Kanallar yükleniyor…" />
                    <TextBlock x:Name="NoChannels" Grid.Row="2" Text="Henüz kanal yok." Style="{StaticResource MutedText}" Margin="8,10,8,0"
                               TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border x:Name="VodPane" Grid.ColumnSpan="2" Visibility="Collapsed" Style="{StaticResource AmbientCanvasSurface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="16,20,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="VodBack" Content="Diziler" Click="OnVodBack" Visibility="Collapsed" Margin="0,0,10,0" />
                        <Button x:Name="VodDetailsButton" DockPanel.Dock="Right" Content="Detaylar" Click="OnVodDetails"
                                IsEnabled="False" Margin="10,0,0,0" />
                        <Button x:Name="LuckyVodButton" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnLucky"
                                ToolTip="Şansıma: listeden rastgele bir içerik seç ve aç" AutomationProperties.Name="Şansıma">
                            <Path Data="{DynamicResource ZpBoltIcon}" Fill="{DynamicResource ZpBoltBrush}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <TextBlock x:Name="VodCount" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock x:Name="VodHeading" Text="Filmler" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Border x:Name="VodListTabs" Grid.Row="1" Margin="0,0,0,10" Background="{StaticResource Canvas}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="3">
                        <Grid>
                        <Canvas ClipToBounds="True">
                            <Border x:Name="VodListIndicator" Background="{StaticResource Active}" BorderBrush="{StaticResource ActiveLine}"
                                    BorderThickness="1" CornerRadius="8" />
                        </Canvas>
                        <UniformGrid x:Name="VodListTabsPanel" Rows="1">
                            <RadioButton x:Name="VodAllTab" IsChecked="True" GroupName="VodLists" Content="Tümü"
                                         Style="{StaticResource SlidingTab}" Padding="8,7" Checked="OnVodListKindChanged" />
                            <RadioButton x:Name="VodFavoritesTab" GroupName="VodLists" Style="{StaticResource SlidingTab}" Padding="8,7"
                                         Checked="OnVodListKindChanged" AutomationProperties.Name="Favorilerim">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{DynamicResource ZpBoltIcon}" Fill="{DynamicResource ZpBoltBrush}" Width="12" Height="12"
                                          Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Favorilerim" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="VodWatchlistTab" GroupName="VodLists" Style="{StaticResource SlidingTab}" Padding="8,7"
                                         Checked="OnVodListKindChanged" AutomationProperties.Name="İzleme listem">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.History}" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="İzleme listem" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        </Grid>
                    </Border>
                    <Border x:Name="ContinueHostList" Grid.Row="2">
                    <!-- Above the list: one row that scrolls sideways. Under the player: rows that wrap to the panel and scroll down. -->
                    <Grid x:Name="ContinuePanel" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="İzlemeye devam et" Style="{StaticResource SectionLabel}" FontSize="13" Margin="2,0,0,8" />
                        <ScrollViewer x:Name="ContinueScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" PanningMode="HorizontalOnly" local:DragScroll.IsEnabled="True">
                            <ItemsControl x:Name="ContinueList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnContinueWatching" Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding Tooltip}"
                                                Width="{Binding Tag.CardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="{Binding Tag.CardHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                AutomationProperties.Name="{Binding Tooltip}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Frame" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                                            BorderThickness="1" CornerRadius="12" Padding="7">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Hover}" />
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ActiveLine}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Hover}" />
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ContinuePoster" CornerRadius="7" Background="{StaticResource Active}" Margin="0,0,10,0"
                                                        Width="{Binding Tag.PosterWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Height="{Binding Tag.PosterHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Tile}" FontFamily="{StaticResource GlyphFont}" Foreground="{StaticResource Accent}"
                                                                   FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                                               local:LogoLoader.Url="{Binding Poster}" local:LogoLoader.DecodeWidth="160">
                                                            <Image.Clip>
                                                                <MultiBinding Converter="{x:Static local:RoundedClipConverter.Instance}" ConverterParameter="7">
                                                                    <Binding ElementName="ContinuePoster" Path="ActualWidth" />
                                                                    <Binding ElementName="ContinuePoster" Path="ActualHeight" />
                                                                </MultiBinding>
                                                            </Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" MaxHeight="40" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Play}" FontSize="12"
                                                                   Foreground="{StaticResource Accent}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding Caption}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    </Border>
                    <ComboBox x:Name="VodCategoryPicker" Grid.Row="3" Margin="0,0,0,10" Width="150" HorizontalAlignment="Left" Height="38"
                              DisplayMemberPath="Label" Style="{StaticResource LibraryPicker}"
                              SelectionChanged="OnVodFilterChanged" AutomationProperties.Name="İçerik kategorisi" />
                    <Grid Grid.Row="3" Margin="158,0,0,10">
                        <TextBox x:Name="VodSearchBox" Padding="36,8,10,8" TextChanged="OnVodSearchChanged" AutomationProperties.Name="İçerik ara" />
                        <TextBlock FontFamily="{StaticResource GlyphFont}" Text="{x:Static local:IconGlyphs.Search}" Foreground="{StaticResource Muted}"
                                   FontSize="16" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="İçerik ara" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=VodSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox x:Name="VodList" Grid.Row="5" PreviewKeyDown="OnVodKeyDown" ContextMenuOpening="OnVodMenuOpening"
                             SelectionChanged="OnVodSelected" AutomationProperties.Name="Xtream içerikleri">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
