                                        <StackPanel>
                                            <TextBlock x:Name="ChannelOsdTitle" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="ChannelOsdSubtitle" Style="{StaticResource MutedText}" FontSize="12"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
