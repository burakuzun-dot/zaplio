<Window x:Class="Zaplio.LegalNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hukuki bilgilendirme · Zaplio" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" KeyDown="OnKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleMouseDown">
                <Grid Height="60" Margin="23,0,13,0">
                    <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" HorizontalAlignment="Right" Click="OnCancel"
                            ToolTip="Kapat" AutomationProperties.Name="Kapat">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                    </Button>
                </Grid>
            </Border>
            <StackPanel Margin="23,18,23,20">
                <StackPanel x:Name="Body" />
                <TextBlock x:Name="More" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="Vazgeç" Click="OnCancel" Margin="0,0,8,0" />
                    <Button x:Name="AcceptButton" Style="{StaticResource Primary}" Click="OnAccept" IsDefault="True">
                        <TextBlock x:Name="AcceptText" Foreground="{StaticResource Ink}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
