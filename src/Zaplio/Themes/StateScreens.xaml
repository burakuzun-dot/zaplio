<!--
  Zaplio – durum ekranları için tema sözlüğü.
  Theme.xaml'da aynı rolü gören anahtarlar varsa buradaki karşılıklarını silip
  onlara yönlendirmen yeterli (ör. ZpAccentBrush yerine kendi AccentBrush anahtarın).
  Tüm ekranlar bu anahtarları DynamicResource ile kullanır.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Renkler -->
    <Color x:Key="ZpBgColor">#0E1020</Color>
    <Color x:Key="ZpSurfaceColor">#151829</Color>
    <Color x:Key="ZpAccentColor">#7B61FF</Color>
    <Color x:Key="ZpBoltColor">#FFC83D</Color>

    <SolidColorBrush x:Key="ZpBgBrush" Color="{StaticResource ZpBgColor}"/>
    <SolidColorBrush x:Key="ZpSurfaceBrush" Color="{StaticResource ZpSurfaceColor}"/>
    <SolidColorBrush x:Key="ZpSurfaceHoverBrush" Color="#1C2038"/>
    <SolidColorBrush x:Key="ZpBorderBrush" Color="#262A45"/>
    <SolidColorBrush x:Key="ZpBorderStrongBrush" Color="#3A3F63"/>
    <SolidColorBrush x:Key="ZpTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ZpMutedTextBrush" Color="#A3A8C7"/>
    <SolidColorBrush x:Key="ZpIconMutedBrush" Color="#7D83A6"/>
    <SolidColorBrush x:Key="ZpAccentBrush" Color="{StaticResource ZpAccentColor}"/>
    <SolidColorBrush x:Key="ZpAccentHoverBrush" Color="#8C76FF"/>
    <SolidColorBrush x:Key="ZpAccentPressedBrush" Color="#6A50EE"/>
    <SolidColorBrush x:Key="ZpBoltBrush" Color="{StaticResource ZpBoltColor}"/>
    <SolidColorBrush x:Key="ZpWarnBrush" Color="#FF7A59"/>
    <SolidColorBrush x:Key="ZpIllustrationLineBrush" Color="#2C3050"/>

    <FontFamily x:Key="ZpFontFamily">pack://application:,,,/Assets/Fonts/#Inter, Segoe UI</FontFamily>

    <!-- Şekiller -->
    <!-- 24x24 ızgarada şimşek ikonu -->
    <Geometry x:Key="ZpBoltIcon">M13,2 L4,14 H11 L10,22 L20,9 H13 Z</Geometry>
    <!-- Logo işareti (100x100 ızgara; görünür alan 20.5,12 – 96.5,88) -->
    <Geometry x:Key="ZpMarkTriangle">M30,20 L30,80 L82,50 Z</Geometry>
    <Geometry x:Key="ZpMarkBolt">M55,25 L37,54 H48 L44,75 L64,44 H53 L58,25 Z</Geometry>
    <Geometry x:Key="ZpRetryIcon">M20,12 A8,8 0 1 1 17.66,6.34 M20,4 V9 H15</Geometry>
    <Geometry x:Key="ZpChevronRight">M9,6 L15,12 L9,18</Geometry>
    <Geometry x:Key="ZpPlusIcon">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="ZpSpinnerArc">M12,3 A9,9 0 1 1 3,12</Geometry>

    <!-- Klavye odağı: sarı çerçeve -->
    <Style x:Key="ZpFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="15" BorderThickness="3"
                            BorderBrush="{DynamicResource ZpBoltBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ana buton (mor) -->
    <Style x:Key="ZpPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ZpTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ZpAccentBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ZpFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="26,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ZpFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZpAccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZpAccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- İkincil buton (çerçeveli) -->
    <Style x:Key="ZpSecondaryButton" TargetType="Button" BasedOn="{StaticResource ZpPrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="{DynamicResource ZpBorderStrongBrush}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZpSurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZpBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ekran başlığı ve açıklama metni -->
    <Style x:Key="ZpStateTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ZpFontFamily}"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ZpTextBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ZpStateBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ZpFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="25"/>
        <Setter Property="Foreground" Value="{DynamicResource ZpMutedTextBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
