<Window x:Class="Zaplio.WatchHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="İzleme geçmişi · Zaplio" Width="610" Height="490" MinHeight="340" MinWidth="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Panel}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" WindowStyle="None" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="HistoryTitleBar" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleMouseDown">
            <DockPanel Margin="22,10,12,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource WindowButton}" Click="OnClose" ToolTip="Kapat" AutomationProperties.Name="İzleme geçmişini kapat">
                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                </Button>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.History}" FontSize="21"
                           Foreground="{StaticResource Accent}" Margin="0,0,9,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="İzleme geçmişi" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceLabel" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,14,22,10">
            <RadioButton x:Name="HistoryTab" GroupName="HistoryFilter" Content="Tümü" Style="{StaticResource SourceOption}" Checked="OnFilter" />
            <RadioButton x:Name="ResumeTab" GroupName="HistoryFilter" Content="Yarım kalanlar" Style="{StaticResource SourceOption}" Checked="OnFilter" />
        </StackPanel>
        <ListBox x:Name="Entries" Grid.Row="2" MouseDoubleClick="OnPlay" AutomationProperties.Name="İzlenen içerikler"
                 SelectionChanged="OnSelectionChanged" Margin="22,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="3,4">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyHistory" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22,12">
            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.History}" FontSize="30" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="EmptyMessage" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,13,22,16">
            <Button Content="Kapat" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="PlayHistoryButton" Click="OnPlay" IsDefault="True" Style="{StaticResource Primary}"
                    AutomationProperties.Name="{Binding Text, ElementName=PlayHistoryText}">
                <TextBlock x:Name="PlayHistoryText" Text="Oynat" Foreground="{StaticResource Ink}" />
            </Button>
        </StackPanel>
    </Grid>
    </Border>
</Window>
