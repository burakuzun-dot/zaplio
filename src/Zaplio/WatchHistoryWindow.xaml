<Window x:Class="Zaplio.WatchHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İzleme geçmişi · Zaplio" Width="610" Height="490" MinHeight="340" MinWidth="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Panel}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="23,19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="İzleme geçmişi" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceLabel" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10">
            <RadioButton x:Name="HistoryTab" GroupName="HistoryFilter" Content="Tümü" Style="{StaticResource SourceOption}" Checked="OnFilter" />
            <RadioButton x:Name="ResumeTab" GroupName="HistoryFilter" Content="Devam et" Style="{StaticResource SourceOption}" Checked="OnFilter" />
        </StackPanel>
        <ListBox x:Name="Entries" Grid.Row="2" MouseDoubleClick="OnPlay" AutomationProperties.Name="İzlenen içerikler"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="3,4">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyMessage" Grid.Row="2" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                   HorizontalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
            <Button Content="Kapat" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="PlayHistoryButton" Click="OnPlay" IsDefault="True" Style="{StaticResource Primary}">
                <TextBlock Text="Oynat" Foreground="{StaticResource Ink}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
