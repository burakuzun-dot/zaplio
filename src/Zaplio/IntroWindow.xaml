<Window x:Class="Zaplio.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zaplio" Icon="Assets/Zaplio.ico" Width="640" Height="360"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0E1020" UseLayoutRounding="True" Cursor="Hand"
        MouseLeftButtonDown="OnSkip" KeyDown="OnKey"
        ToolTip="Atlamak için tıkla">
    <Grid>
        <!-- Last frame: shown when animations are reduced or the video cannot be played. -->
        <Image x:Name="StillFrame" Source="Assets/Splash.png" Stretch="Uniform" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" IsMuted="True"
                      MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
    </Grid>
</Window>
