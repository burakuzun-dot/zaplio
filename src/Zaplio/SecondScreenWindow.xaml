<Window x:Class="Zaplio.SecondScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Zaplio · İkinci ekran" Icon="Assets/Zaplio.ico" WindowStyle="None" ResizeMode="NoResize"
        Background="Black" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" ShowActivated="False">
    <vlc:VideoView x:Name="Video" Visibility="Hidden">
        <Grid Background="#02000000" PreviewKeyDown="OnPreviewKeyDown" MouseLeftButtonDown="OnMouseDown">
            <Border x:Name="Hint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Padding="14,9" CornerRadius="10"
                    Background="#D9121621" BorderBrush="{StaticResource Line}" BorderThickness="1" IsHitTestVisible="False">
                <TextBlock Text="Esc ya da çift tık · ana pencereye geri al" FontSize="13" />
            </Border>
        </Grid>
    </vlc:VideoView>
</Window>
