<!--
  "Bu kanal şu an uykuda" ekranı. Oynatıcı alanının üstüne bindirilir (VideoView ile aynı Grid hücresine).
  Görünür olduğunda animasyonlar ve geri sayım kendiliğinden başlar, gizlenince durur.
-->
<UserControl x:Class="Zaplio.Views.ChannelSleepingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             FontFamily="{DynamicResource ZpFontFamily}">
    <UserControl.Resources>
        <!-- Sürekli oynayan sakin animasyonlar -->
        <Storyboard x:Key="IdleStoryboard">
            <!-- Çizim hafifçe nefes alır -->
            <DoubleAnimation Storyboard.TargetName="BreatheShift" Storyboard.TargetProperty="Y"
                             From="0" To="-6" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Son pil çubuğu yanıp söner -->
            <DoubleAnimation Storyboard.TargetName="LowBar" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <!-- Şimşek ara ara yanmaya çalışıp söner -->
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BoltFill" Storyboard.TargetProperty="Color"
                                          Duration="0:0:4" RepeatBehavior="Forever">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#262A45"/>
                <LinearColorKeyFrame KeyTime="0:0:2.48" Value="#262A45"/>
                <LinearColorKeyFrame KeyTime="0:0:2.64" Value="#5E5330"/>
                <LinearColorKeyFrame KeyTime="0:0:2.8" Value="#262A45"/>
                <LinearColorKeyFrame KeyTime="0:0:2.96" Value="#4A4330"/>
                <LinearColorKeyFrame KeyTime="0:0:3.12" Value="#262A45"/>
            </ColorAnimationUsingKeyFrames>
            <!-- Z z Z: sırayla yukarı süzülür -->
            <DoubleAnimation Storyboard.TargetName="Z1Shift" Storyboard.TargetProperty="Y" From="0" To="-70" Duration="0:0:3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Z1Shift" Storyboard.TargetProperty="X" From="0" To="26" Duration="0:0:3" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z1" Storyboard.TargetProperty="Opacity" Duration="0:0:3" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9"/><LinearDoubleKeyFrame KeyTime="0:0:3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Z2Shift" Storyboard.TargetProperty="Y" From="0" To="-70" Duration="0:0:3" BeginTime="0:0:1" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Z2Shift" Storyboard.TargetProperty="X" From="0" To="26" Duration="0:0:3" BeginTime="0:0:1" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z2" Storyboard.TargetProperty="Opacity" Duration="0:0:3" BeginTime="0:0:1" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9"/><LinearDoubleKeyFrame KeyTime="0:0:3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Z3Shift" Storyboard.TargetProperty="Y" From="0" To="-70" Duration="0:0:3" BeginTime="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Z3Shift" Storyboard.TargetProperty="X" From="0" To="26" Duration="0:0:3" BeginTime="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Z3" Storyboard.TargetProperty="Opacity" Duration="0:0:3" BeginTime="0:0:2" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9"/><LinearDoubleKeyFrame KeyTime="0:0:3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="SpinnerStoryboard">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#171A30" Offset="0"/>
                <GradientStop Color="#0B0D18" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Sol üst: kanal bilgisi -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,28,0,0"
                Padding="14,8" CornerRadius="10" Background="#0FFFFFFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ChannelNumberText" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource ZpTextBrush}" Margin="0,0,10,0"/>
                <TextBlock x:Name="ChannelNameText" FontSize="14" Foreground="#C9CCE0"/>
            </StackPanel>
        </Border>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <!-- Çizim: şarjı bitmiş, uyuyan şimşek -->
            <Canvas Width="240" Height="160" HorizontalAlignment="Center" Margin="0,0,0,28"
                    AutomationProperties.Name="Şarjı bitmiş, uyuyan bir şimşek">
                <Canvas.RenderTransform><TranslateTransform x:Name="BreatheShift"/></Canvas.RenderTransform>
                <Rectangle Canvas.Left="20" Canvas.Top="30" Width="180" Height="100" RadiusX="22" RadiusY="22"
                           Fill="#12152A" Stroke="{DynamicResource ZpBorderStrongBrush}" StrokeThickness="6"/>
                <Rectangle Canvas.Left="204" Canvas.Top="62" Width="16" Height="36" RadiusX="6" RadiusY="6"
                           Fill="{DynamicResource ZpBorderStrongBrush}"/>
                <Rectangle x:Name="LowBar" Canvas.Left="34" Canvas.Top="44" Width="22" Height="72"
                           RadiusX="8" RadiusY="8" Fill="{DynamicResource ZpWarnBrush}"/>
                <Path Data="M120,44 L94,86 H114 L106,118 L140,72 H120 L128,44 Z"
                      Stroke="#4A4F70" StrokeThickness="4" StrokeLineJoin="Round">
                    <Path.Fill><SolidColorBrush x:Name="BoltFill" Color="#262A45"/></Path.Fill>
                </Path>
                <TextBlock x:Name="Z1" Text="z" Canvas.Left="196" Canvas.Top="10" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ZpIconMutedBrush}" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="Z1Shift"/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="Z2" Text="z" Canvas.Left="206" Canvas.Top="0" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource ZpIconMutedBrush}" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="Z2Shift"/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="Z3" Text="Z" Canvas.Left="216" Canvas.Top="-10" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource ZpIconMutedBrush}" Opacity="0">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="Z3Shift"/></TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>

            <TextBlock Style="{DynamicResource ZpStateTitle}" Text="Bu kanal şu an uykuda"/>
            <TextBlock Style="{DynamicResource ZpStateBody}" Margin="0,12,0,28"
                       Text="Yayın şu anda açılmıyor. Kanal yayına ara vermiş ya da bağlantı geçici olarak kesilmiş olabilir."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="WakeButton" Style="{DynamicResource ZpPrimaryButton}" Margin="0,0,12,0"
                        Click="OnWakeClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource ZpRetryIcon}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Margin="0,0,10,0"/>
                        <TextBlock Text="Uyandır" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource ZpSecondaryButton}" Click="OnNextClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sonraki kanal" VerticalAlignment="Center"/>
                        <Path Data="{DynamicResource ZpChevronRight}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Margin="10,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Durum satırı: geri sayım ya da "uyandırılıyor" -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" MinHeight="22">
                <Path x:Name="Spinner" Data="{DynamicResource ZpSpinnerArc}" Width="16" Height="16" Stretch="Uniform"
                      Stroke="{DynamicResource ZpBoltBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Margin="0,0,8,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></Path.RenderTransform>
                </Path>
                <TextBlock x:Name="StatusText" FontSize="14" Foreground="{DynamicResource ZpMutedTextBrush}"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
