<!--
  "İnternet bağlantın koptu" ekranı. Ana pencerenin içeriğinin üstüne tam ekran bindirilir.
  Windows'un ağ bildirimlerini kendisi dinler; bağlantı geri gelince ConnectionRestored tetiklenir.
-->
<UserControl x:Class="Zaplio.Views.OfflineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Background="{DynamicResource ZpBgBrush}"
             FontFamily="{DynamicResource ZpFontFamily}">
    <UserControl.Resources>
        <Storyboard x:Key="IdleStoryboard">
            <!-- Fiş kablosunun ucundan sallanır -->
            <DoubleAnimation Storyboard.TargetName="PlugRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="-3" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PlugShift" Storyboard.TargetProperty="X"
                             From="0" To="-10" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Kıvılcımlar sırayla çakar -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark1" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.4" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.4" BeginTime="0:0:0.8" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark3" Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:2.4" BeginTime="0:0:1.6" RepeatBehavior="Forever">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <!-- "Çevrimdışı" noktası nabız gibi atar -->
            <DoubleAnimation Storyboard.TargetName="OfflineDot" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.35" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="SpinnerStoryboard">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <DockPanel>
        <!-- Üst çubuk -->
        <Border DockPanel.Dock="Top" Height="64" Padding="32,0" BorderThickness="0,0,0,1" BorderBrush="#1E2238">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="28" Height="28" Margin="0,0,10,0">
                        <Canvas Width="76" Height="76">
                            <Canvas.RenderTransform><TranslateTransform X="-20.5" Y="-12"/></Canvas.RenderTransform>
                            <Path Data="{DynamicResource ZpMarkTriangle}" Fill="{DynamicResource ZpAccentBrush}"
                                  Stroke="{DynamicResource ZpAccentBrush}" StrokeThickness="12" StrokeLineJoin="Round"/>
                            <Path Data="{DynamicResource ZpMarkBolt}" Fill="{DynamicResource ZpBoltBrush}"
                                  Stroke="{DynamicResource ZpBgBrush}" StrokeThickness="5" StrokeLineJoin="Round"/>
                            <Path Data="{DynamicResource ZpMarkBolt}" Fill="{DynamicResource ZpBoltBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Zaplio" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource ZpTextBrush}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6" CornerRadius="999"
                        Background="#1FFF7A59">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="OfflineDot" Width="8" Height="8" Fill="{DynamicResource ZpWarnBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Çevrimdışı" FontSize="13" FontWeight="SemiBold" Foreground="#FFB4A1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <!-- Çizim: prizden çıkmış fiş -->
            <Canvas Width="480" Height="200" HorizontalAlignment="Center" Margin="0,0,0,28" ClipToBounds="False"
                    AutomationProperties.Name="Fişi prizden çıkmış bir kablo">
                <Path Data="M350,100 C400,100 420,128 480,128" Stroke="{DynamicResource ZpBorderStrongBrush}"
                      StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Rectangle Canvas.Left="290" Canvas.Top="64" Width="60" Height="72" RadiusX="14" RadiusY="14"
                           Fill="#1C2038" Stroke="{DynamicResource ZpBorderStrongBrush}" StrokeThickness="4"/>
                <Rectangle Canvas.Left="296" Canvas.Top="84" Width="10" Height="9" RadiusX="2" RadiusY="2" Fill="#0B0D18"/>
                <Rectangle Canvas.Left="296" Canvas.Top="107" Width="10" Height="9" RadiusX="2" RadiusY="2" Fill="#0B0D18"/>

                <!-- Fiş: kablonun başladığı noktanın (0,128) etrafında sallanır -->
                <Canvas Width="240" Height="200" RenderTransformOrigin="0,0.64">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="PlugRotate"/>
                            <TranslateTransform x:Name="PlugShift"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Path Data="M0,128 C60,128 90,100 152,100" Stroke="#5A47CC" StrokeThickness="10"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Rectangle Canvas.Left="148" Canvas.Top="70" Width="64" Height="60" RadiusX="14" RadiusY="14"
                               Fill="{DynamicResource ZpAccentBrush}"/>
                    <Rectangle Canvas.Left="160" Canvas.Top="84" Width="6" Height="32" RadiusX="3" RadiusY="3" Fill="#9F8CFF"/>
                    <Rectangle Canvas.Left="210" Canvas.Top="84" Width="28" Height="9" RadiusX="3" RadiusY="3" Fill="#C9CCE0"/>
                    <Rectangle Canvas.Left="210" Canvas.Top="107" Width="28" Height="9" RadiusX="3" RadiusY="3" Fill="#C9CCE0"/>
                </Canvas>

                <Path x:Name="Spark1" Opacity="0" Data="M258,74 L266,86 L260,88 L270,102"
                      Stroke="{DynamicResource ZpBoltBrush}" StrokeThickness="3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="Spark2" Opacity="0" Data="M262,96 L274,104 L266,108 L280,116"
                      Stroke="{DynamicResource ZpBoltBrush}" StrokeThickness="3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="Spark3" Opacity="0" Data="M256,118 L268,126 L262,130 L272,140"
                      Stroke="{DynamicResource ZpBoltBrush}" StrokeThickness="3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>

            <TextBlock Style="{DynamicResource ZpStateTitle}" Text="İnternet bağlantın koptu"/>
            <TextBlock Style="{DynamicResource ZpStateBody}" Margin="0,12,0,28"
                       Text="Wi-Fi ya da kablo bağlantını kontrol et. Bağlantı geri geldiğinde kaldığın yerden devam edeceğiz."/>

            <Button x:Name="RetryButton" Style="{DynamicResource ZpPrimaryButton}" HorizontalAlignment="Center"
                    Click="OnRetryClick">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="18" Height="18" Margin="0,0,10,0">
                        <Path x:Name="RetryIcon" Data="{DynamicResource ZpRetryIcon}" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                        <Path x:Name="Spinner" Data="{DynamicResource ZpSpinnerArc}" Stretch="Uniform" Visibility="Collapsed"
                              Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform x:Name="SpinnerRotate"/></Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="RetryText" Text="Tekrar bağlan" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="StatusText" Margin="0,20,0,0" MinHeight="22" FontSize="14" TextAlignment="Center"
                       Foreground="{DynamicResource ZpMutedTextBrush}" AutomationProperties.LiveSetting="Polite"
                       Text="Arka planda bağlantıyı aramaya devam ediyoruz."/>
        </StackPanel>
    </DockPanel>
</UserControl>
