<Window x:Class="Zaplio.GuideGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Yayın rehberi · Zaplio" Width="1180" Height="720" MinWidth="720" MinHeight="420" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource Panel}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseWheel="OnPreviewMouseWheel">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleMouseDown"
                    Background="Transparent">
                <Grid Height="58" Margin="20,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:IconGlyphs.Calendar}" FontFamily="{StaticResource GlyphFont}" FontSize="21"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock x:Name="Heading" Text="Yayın rehberi" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="Subheading" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="12,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="NowButton" Content="Şimdi" Click="OnNow" Margin="0,0,10,0" ToolTip="Şu anki saate dön" />
                        <Button Style="{StaticResource WindowButton}" Click="OnClose" ToolTip="Kapat (Esc)" AutomationProperties.Name="Kapat">
                            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ruler -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Background="{StaticResource Canvas}">
                <TextBlock Text="KANAL" Style="{StaticResource SectionLabel}" Margin="20,0,0,0" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="TimelineHost" Grid.Row="1" Grid.Column="1" Height="34" ClipToBounds="True" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Background="{StaticResource Canvas}" SizeChanged="OnTimelineSizeChanged">
                <Canvas x:Name="Ruler" Loaded="OnTimelineLoaded" HorizontalAlignment="Left" />
            </Border>

            <!-- Rows -->
            <ListBox x:Name="Rows" Grid.Row="2" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Kanallar ve programlar">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="60">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="OnChannelClick" ToolTip="Kanalı oynat">
                                <Grid Margin="16,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Active}" HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                   local:LogoLoader.Url="{Binding Logo}" local:LogoLoader.DecodeWidth="72" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <ItemsControl ItemsSource="{Binding Cells}" Loaded="OnTimelineLoaded" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="5" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="49" CornerRadius="8" Padding="9,5" BorderThickness="1" Cursor="Hand"
                                                    MouseLeftButtonUp="OnCellClick" ToolTipService.InitialShowDelay="400"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Border.ToolTip>
                                                    <StackPanel MaxWidth="340">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Time}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border.ToolTip>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Surface}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Active}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource ActiveLine}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- "Now" line over the rows -->
            <Border Grid.Row="2" Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
                <Canvas Loaded="OnTimelineLoaded" HorizontalAlignment="Left">
                    <Rectangle x:Name="NowLine" Width="2" Fill="{StaticResource Error}" Opacity="0.85"
                               Height="{Binding ActualHeight, ElementName=Rows}" />
                </Canvas>
            </Border>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420" Visibility="Collapsed"
                       Text="Bu listedeki kanallar için program bilgisi yok. Rehber, kaynağın bildirdiği ya da elle bağladığın XMLTV adresinden gelir." />

            <ScrollBar x:Name="TimeScroll" Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Height="12" ValueChanged="OnTimeScroll"
                       AutomationProperties.Name="Saat" />
            <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,7">
                <TextBlock x:Name="Status" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="Programa tıkla: yayındaysa kanal açılır, geçmişteyse arşivden oynar. Saatler arasında Shift + tekerlek ya da ← → ile gez."
                           AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
    </Border>
</Window>
