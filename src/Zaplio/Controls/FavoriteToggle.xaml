<!--
  Favori şimşek düğmesi. Kanal listesindeki her satırın sağına konur.
  Kullanım:
    <controls:FavoriteToggle IsFavorite="{Binding IsFavorite, Mode=TwoWay}"
                             ChannelName="{Binding Name}"/>
  Favoriye eklenince: şimşek sarıya dolup zıplar, etrafına kıvılcım saçılır, halka genişleyip söner.
-->
<UserControl x:Class="Zaplio.Controls.FavoriteToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="44">
    <UserControl.Resources>
        <Storyboard x:Key="AddedStoryboard">
            <!-- Dolu şimşek zıplar -->
            <DoubleAnimation Storyboard.TargetName="FilledScale" Storyboard.TargetProperty="ScaleX"
                             From="0.3" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FilledScale" Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Halka -->
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="0.3" To="1.5" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="0.3" To="1.5" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                             From="0.9" To="0" Duration="0:0:0.5"/>
            <!-- Kıvılcımlar dışa doğru açılıp söner -->
            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleX"
                             From="0.45" To="1.15" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SparkScale" Storyboard.TargetProperty="ScaleY"
                             From="0.45" To="1.15" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Sparks" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" BeginTime="0:0:0.1" Duration="0:0:0.5"/>
        </Storyboard>
    </UserControl.Resources>

    <ToggleButton x:Name="Toggle" Cursor="Hand"
                  IsChecked="{Binding IsFavorite, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                  FocusVisualStyle="{DynamicResource ZpFocusVisual}">
        <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Bd" CornerRadius="12" Background="Transparent">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZpSurfaceHoverBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ToggleButton.Template>

        <Grid Width="44" Height="44">
            <!-- Halka -->
            <Ellipse x:Name="Ring" Width="40" Height="40" StrokeThickness="2" Opacity="0"
                     Stroke="{DynamicResource ZpBoltBrush}" RenderTransformOrigin="0.5,0.5"
                     IsHitTestVisible="False">
                <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- 8 kıvılcım: merkezden dışa doğru çizgiler. RenderTransform yerleşimi etkilemediği
                 için büyüyünce düğmenin dışına taşar, kırpılmaz. -->
            <Canvas x:Name="Sparks" Width="44" Height="44" Opacity="0" IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform><ScaleTransform x:Name="SparkScale"/></Canvas.RenderTransform>
                <Path Stroke="{DynamicResource ZpBoltBrush}" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M22,0 L22,7 M22,37 L22,44 M0,22 L7,22 M37,22 L44,22 M6.4,6.4 L11.4,11.4 M32.6,32.6 L37.6,37.6 M37.6,6.4 L32.6,11.4 M6.4,37.6 L11.4,32.6"/>
            </Canvas>

            <!-- Boş şimşek -->
            <Path x:Name="OutlineBolt" Width="24" Height="24" Stretch="Uniform"
                  Data="{DynamicResource ZpBoltIcon}" Fill="Transparent"
                  Stroke="{DynamicResource ZpIconMutedBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>

            <!-- Dolu şimşek -->
            <Path x:Name="FilledBolt" Width="24" Height="24" Stretch="Uniform" Visibility="Collapsed"
                  Data="{DynamicResource ZpBoltIcon}" Fill="{DynamicResource ZpBoltBrush}"
                  Stroke="{DynamicResource ZpBoltBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform x:Name="FilledScale"/></Path.RenderTransform>
            </Path>
        </Grid>
    </ToggleButton>
</UserControl>
