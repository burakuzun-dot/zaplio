<Window x:Class="Zaplio.MediaDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="İçerik detayları" Width="690" Height="440"
        MinWidth="520" MinHeight="360" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="23">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Surface}" CornerRadius="10">
            <Image x:Name="Poster" Stretch="Uniform" />
        </Border>
        <ScrollViewer Grid.Column="1" Margin="19,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Meta" Style="{StaticResource MutedText}" Margin="0,7,0,13" TextWrapping="Wrap" />
                <TextBlock x:Name="Synopsis" TextWrapping="Wrap" FontSize="14" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Kapat" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource Primary}" Click="OnActivate" IsDefault="True">
                <TextBlock x:Name="ActionLabel" Foreground="{StaticResource Ink}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
