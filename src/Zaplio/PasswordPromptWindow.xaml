<Window x:Class="Zaplio.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zaplio" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleMouseDown">
                <Grid Height="60" Margin="23,0,13,0">
                    <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource WindowButton}" HorizontalAlignment="Right" Click="OnClose"
                            ToolTip="Kapat" AutomationProperties.Name="Kapat">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                    </Button>
                </Grid>
            </Border>
            <StackPanel Margin="23,17,23,19">
                <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9" />
                <TextBlock x:Name="FirstLabel" Text="Parola" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                <PasswordBox x:Name="First" AutomationProperties.Name="Parola" PasswordChanged="OnChanged" />
                <StackPanel x:Name="ConfirmPanel" Margin="0,10,0,0">
                    <TextBlock Text="Parolayı yeniden yaz" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <PasswordBox x:Name="Second" AutomationProperties.Name="Parolayı yeniden yaz" PasswordChanged="OnChanged" />
                </StackPanel>
                <TextBlock x:Name="Problem" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Vazgeç" Click="OnClose" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="OkButton" Style="{StaticResource Primary}" Click="OnOk" IsDefault="True" IsEnabled="False">
                        <TextBlock x:Name="OkText" Text="Tamam" Foreground="{DynamicResource Ink}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
