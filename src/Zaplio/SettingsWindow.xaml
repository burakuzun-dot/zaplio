<Window x:Class="Zaplio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ayarlar · Zaplio" Width="550" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="{StaticResource Panel}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="3">
                            <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Fill="{StaticResource Muted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Active}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ActiveLine}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleMouseDown">
                <Grid Height="65" Margin="23,0,13,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:IconGlyphs.Settings}" FontFamily="{StaticResource GlyphFont}"
                                   FontSize="23" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Ayarlar" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource WindowButton}" HorizontalAlignment="Right" Click="OnCancel"
                            ToolTip="Kapat" AutomationProperties.Name="Kapat">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                    </Button>
                </Grid>
            </Border>
            <StackPanel Margin="23,17,23,19">
                <TextBlock Text="AÇILIŞ" Style="{StaticResource SectionLabel}" Margin="0,0,0,7" />
                <Grid Height="39">
                    <TextBlock Text="Açılış animasyonunu göster" VerticalAlignment="Center" Margin="0,0,53,0"
                               ToolTip="Kapalıyken uygulama doğrudan açılır (yaklaşık 3 saniye daha hızlı)" />
                    <CheckBox x:Name="ShowIntro" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Açılış animasyonunu göster" />
                </Grid>
                <DockPanel Margin="0,0,0,7">
                    <ComboBox x:Name="StartupPicker" DockPanel.Dock="Right" Width="157" DisplayMemberPath="Label"
                              Style="{StaticResource LibraryPicker}" AutomationProperties.Name="Açılış ekranı" />
                    <TextBlock Text="Açılış ekranı" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Height="39">
                    <TextBlock Text="Son kullanılan kaynakla aç" VerticalAlignment="Center" Margin="0,0,53,0" />
                    <CheckBox x:Name="RememberSource" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Son kullanılan kaynakla aç" />
                </Grid>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,13" />
                <TextBlock Text="OYNATMA" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <Grid Height="39">
                    <TextBlock Text="Kanalı tıklayınca oynat" VerticalAlignment="Center" Margin="0,0,53,0" />
                    <CheckBox x:Name="AutoPlayChannel" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Kanalı tıklayınca oynat" />
                </Grid>
                <Grid Height="39">
                    <TextBlock Text="Film ve dizilerde kaldığım yeri hatırla" VerticalAlignment="Center" Margin="0,0,53,0" />
                    <CheckBox x:Name="ResumeOnDemand" Style="{StaticResource SettingsSwitch}"
                              AutomationProperties.Name="Film ve dizilerde kaldığım yeri hatırla" />
                </Grid>
                <Grid Height="39">
                    <TextBlock Text="Aynı kanalın kalitelerini tek satırda birleştir" VerticalAlignment="Center" Margin="0,0,53,0"
                               ToolTip="Kanal A HD / FHD / 4K gibi kopyalar tek satırda görünür; açılmayan yayında otomatik olarak diğerine geçilir" />
                    <CheckBox x:Name="MergeQualities" Style="{StaticResource SettingsSwitch}"
                              AutomationProperties.Name="Aynı kanalın kalitelerini tek satırda birleştir" />
                </Grid>
                <DockPanel Margin="0,0,0,7">
                    <ComboBox x:Name="QualityPicker" DockPanel.Dock="Right" Width="200" DisplayMemberPath="Label"
                              Style="{StaticResource LibraryPicker}" AutomationProperties.Name="Kanal kalitesi" />
                    <TextBlock Text="Kanal kalitesi" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Height="39">
                    <TextBlock Text="Kanal logolarını ve afişleri göster" VerticalAlignment="Center" Margin="0,0,53,0" />
                    <CheckBox x:Name="ShowLogos" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Kanal logolarını ve afişleri göster" />
                </Grid>
                <Grid Height="39">
                    <TextBlock Text="Kopan canlı yayına otomatik yeniden bağlan" VerticalAlignment="Center" Margin="0,0,53,0" />
                    <CheckBox x:Name="AutoReconnect" Style="{StaticResource SettingsSwitch}"
                              AutomationProperties.Name="Kopan canlı yayına otomatik yeniden bağlan" />
                </Grid>
                <DockPanel Height="44">
                    <TextBlock DockPanel.Dock="Right" MinWidth="39" Text="{Binding Value, ElementName=SoundSlider, StringFormat={}{0:0}%}"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center" TextAlignment="Right" />
                    <Slider x:Name="SoundSlider" DockPanel.Dock="Right" Width="120" Style="{StaticResource VolumeSlider}" Minimum="0"
                            Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            AutomationProperties.Name="Ses düzeyi" />
                    <TextBlock Text="Ses düzeyi" VerticalAlignment="Center" />
                </DockPanel>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,13" />
                <TextBlock Text="BAKIM" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <Grid Height="39">
                    <TextBlock Text="Açılışta yeni sürümü denetle" VerticalAlignment="Center" Margin="0,0,53,0" />
                    <CheckBox x:Name="CheckForUpdates" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Açılışta yeni sürümü denetle" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Önbelleği temizle" Click="OnClearCache" Margin="0,0,8,0"
                            ToolTip="Kayıtlı kanal listelerini ve yayın rehberlerini siler" />
                    <Button Content="Günlük klasörünü aç" Click="OnOpenLogs" ToolTip="Hata günlüklerinin bulunduğu klasörü açar" />
                </StackPanel>
                <TextBlock x:Name="MaintenanceStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,13" />
                <TextBlock Text="HAKKINDA" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Kısayollar (F1)" Click="OnShortcuts" Margin="0,0,8,0" />
                        <Button Content="Hukuki" Click="OnLegalNotice" Margin="0,0,8,0" ToolTip="İçerik sorumluluğu ve hukuki bilgilendirme" />
                        <Button Content="Proje sayfası" Click="OnProjectPage" ToolTip="GitHub: kaynak kod, sürümler, hata bildirimi" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                        <TextBlock Text="Açık kaynak · MIT lisansı" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
                    <Button Content="Vazgeç" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="OnSave" IsDefault="True">
                        <TextBlock Text="Kaydet" Foreground="{StaticResource Ink}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
