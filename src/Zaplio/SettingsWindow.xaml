<Window x:Class="Zaplio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zaplio"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ayarlar · Zaplio" Width="800" Height="580" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="{StaticResource Panel}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="3">
                            <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Fill="{StaticResource Muted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Active}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ActiveLine}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left menu item -->
        <Style x:Key="SettingsNav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="GroupName" Value="SettingsPages" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource GlyphFont}" FontSize="18" Width="26"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource Active}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource ActiveLine}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageIntro" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <!-- One setting: title and a short explanation on the left, the control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleMouseDown" Background="Transparent">
                <Grid Height="60" Margin="22,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:IconGlyphs.Settings}" FontFamily="{StaticResource GlyphFont}"
                                   FontSize="21" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Ayarlar" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource WindowButton}" HorizontalAlignment="Right" Click="OnCancel"
                            ToolTip="Kapat" AutomationProperties.Name="Kapat">
                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Close}" FontSize="17" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Menu -->
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Background="{StaticResource Canvas}">
                    <StackPanel Margin="12,16,12,12">
                        <RadioButton x:Name="SourcesNav" Style="{StaticResource SettingsNav}" Content="Kaynaklar" Tag="{x:Static local:IconGlyphs.Plug}"
                                     Checked="OnPageChanged" />
                        <RadioButton x:Name="PlaybackNav" Style="{StaticResource SettingsNav}" Content="Oynatma" Tag="{x:Static local:IconGlyphs.Play}"
                                     Checked="OnPageChanged" />
                        <RadioButton x:Name="LookNav" Style="{StaticResource SettingsNav}" Content="Görünüm" Tag="{x:Static local:IconGlyphs.Television}"
                                     Checked="OnPageChanged" />
                        <RadioButton x:Name="GeneralNav" Style="{StaticResource SettingsNav}" Content="Genel" Tag="{x:Static local:IconGlyphs.Settings}"
                                     Checked="OnPageChanged" />
                        <RadioButton x:Name="AboutNav" Style="{StaticResource SettingsNav}" Content="Hakkında" Tag="{x:Static local:IconGlyphs.Info}"
                                     Checked="OnPageChanged" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid Margin="30,24,30,10">

                        <!-- Sources -->
                        <StackPanel x:Name="SourcesPage">
                            <TextBlock Text="Kaynaklar" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageIntro}"
                                       Text="M3U listelerin ve Xtream hesapların. Kullanmak istediğin kaynağa tıkla. Seçim, ekleme ve kaldırma hemen uygulanır; Kaydet'e basman gerekmez." />
                            <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="6">
                                <Grid>
                                    <ListBox x:Name="SourceList" Background="Transparent" BorderThickness="0" SelectionChanged="OnSourceSelected"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Aktif kaynak">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource Active}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource GlyphFont}" FontSize="16"
                                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="9" Padding="9,3" VerticalAlignment="Center" Margin="8,0,2,0"
                                                            Background="{StaticResource Surface}" BorderBrush="{StaticResource ActiveLine}" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Kullanılıyor" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="NoSources" Text="Henüz kaynak yok. İlk listeni ekleyerek başla." Style="{StaticResource MutedText}"
                                               Margin="10,14" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border x:Name="AccountPanel" Margin="0,12,0,0" Padding="12,10" CornerRadius="12" Visibility="Collapsed"
                                    Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <DockPanel>
                                    <Button x:Name="CheckAccountButton" DockPanel.Dock="Right" Content="Aboneliği kontrol et" Click="OnCheckAccount"
                                            VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource GlyphFont}" Text="{x:Static local:IconGlyphs.Server}"
                                               FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Abonelik" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AccountText" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource Primary}" Click="OnManageSources" Margin="0,0,8,0"
                                        AutomationProperties.Name="{Binding Text, ElementName=ManageSourcesText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ManageSourcesIcon" Style="{StaticResource Glyph}" FontSize="17" Margin="0,0,6,0" />
                                        <TextBlock x:Name="ManageSourcesText" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RefreshListsButton" Click="OnRefreshLists" AutomationProperties.Name="Listeleri yenile"
                                        ToolTip="Aktif kaynağın listelerini sağlayıcıdan yeniden al (F5)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{x:Static local:IconGlyphs.Refresh}" FontSize="17" Margin="0,0,6,0" />
                                        <TextBlock Text="Listeleri yenile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="RefreshHint" Style="{StaticResource SettingHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Yenileme ana pencerede açık olan bölümün (Canlı TV, Filmler ya da Diziler) listesini yeniler. Kısayolu F5." />
                        </StackPanel>

                        <!-- Playback -->
                        <StackPanel x:Name="PlaybackPage" Visibility="Collapsed">
                            <TextBlock Text="Oynatma" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageIntro}" Text="Kanallar ve içerikler nasıl açılsın." />

                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Kanala tıklayınca oynat" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Kapalıyken kanal yalnızca seçilir; oynatmak için Enter'a ya da Oynat düğmesine bas." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="AutoPlayChannel" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Kanala tıklayınca oynat" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Kopan yayına yeniden bağlan" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Canlı yayın koparsa birkaç kez kendiliğinden yeniden dener." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="AutoReconnect" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Kopan yayına yeniden bağlan" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Kayda hazır tut" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Kayıt tuşuna basınca ya da kaydı bitirince yayın durmaz, yeniden yüklenmez. Yayının bir kopyası yalnızca bu bilgisayarda Zaplio'ya akar; kayıt yokken diske bir şey yazılmaz. Bir sonraki yayından itibaren geçerli." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="RecordReady" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Kayda hazır tut" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Kaldığım yeri hatırla" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Film ve dizilerde yarıda bıraktığın yerden devam eder." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="ResumeOnDemand" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Kaldığım yeri hatırla" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Kaliteleri tek satırda birleştir" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Kanal A HD, FHD ve 4K tek satırda görünür; açılmayan yayında diğerine geçilir." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="MergeQualities" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Kaliteleri tek satırda birleştir" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Kanal kalitesi" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Otomatik, bağlantı hızına göre seçer." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ComboBox x:Name="QualityPicker" Grid.Column="1" Width="200" DisplayMemberPath="Label" VerticalAlignment="Center"
                                          Style="{StaticResource LibraryPicker}" AutomationProperties.Name="Kanal kalitesi" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ses düzeyi" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                                <Slider x:Name="SoundSlider" Grid.Column="1" Width="150" Style="{StaticResource VolumeSlider}" Focusable="True" Minimum="0"
                                        Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        AutomationProperties.Name="Ses düzeyi" />
                                <TextBlock Grid.Column="2" MinWidth="44" Text="{Binding Value, ElementName=SoundSlider, StringFormat={}{0:0}%}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Look -->
                        <StackPanel x:Name="LookPage" Visibility="Collapsed">
                            <TextBlock Text="Görünüm" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageIntro}" Text="Uygulamanın nasıl görüneceği." />

                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Logolar ve afişler" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Kapalıyken internetten görsel indirilmez; liste daha sade görünür." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="ShowLogos" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Logolar ve afişler" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Ortam ışığı" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Videonun renkleri pencere kenarlarına hafifçe yansır." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="AmbientLight" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Ortam ışığı" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Açılış animasyonu" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Kapalıyken uygulama yaklaşık 3 saniye daha hızlı açılır." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="ShowIntro" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Açılış animasyonu" />
                            </Grid>
                        </StackPanel>

                        <!-- General -->
                        <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                            <TextBlock Text="Genel" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageIntro}" Text="Açılış ve güncellemeler." />

                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Açılış ekranı" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Uygulama açılınca ilk görünen bölüm." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <ComboBox x:Name="StartupPicker" Grid.Column="1" Width="170" DisplayMemberPath="Label" VerticalAlignment="Center"
                                          Style="{StaticResource LibraryPicker}" AutomationProperties.Name="Açılış ekranı" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Son kaynakla aç" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="En son kullandığın kaynak seçili açılır." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="RememberSource" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Son kaynakla aç" />
                            </Grid>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Yeni sürümü denetle" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Açılışta GitHub'daki son sürüme bakar; yalnızca haber verir, kendiliğinden kurmaz." Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox x:Name="CheckForUpdates" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Yeni sürümü denetle" />
                            </Grid>
                        </StackPanel>

                        <!-- About & maintenance -->
                        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                            <TextBlock Text="Hakkında" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageIntro}" Text="Sürüm, yardım ve bakım." />

                            <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                                    Padding="16,14" Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/Brand/zaplio-128.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Açık kaynak · MIT lisansı" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,0,0,24">
                                <Button Content="Kısayollar (F1)" Click="OnShortcuts" Margin="0,0,8,8" />
                                <Button Content="Hukuki bilgilendirme" Click="OnLegalNotice" Margin="0,0,8,8" ToolTip="İçerik sorumluluğu ve hukuki bilgilendirme" />
                                <Button Content="Proje sayfası" Click="OnProjectPage" Margin="0,0,8,8" ToolTip="GitHub: kaynak kod, sürümler, hata bildirimi" />
                                <Button Content="Açık kaynak lisansları" Click="OnLicenses" Margin="0,0,8,8" ToolTip="Zaplio'nun kullandığı bileşenlerin lisansları" />
                            </WrapPanel>

                            <TextBlock Text="Bakım" Style="{StaticResource SettingTitle}" FontSize="15" Margin="0,0,0,4" />
                            <TextBlock Text="Bir şeyler ters giderse işine yarar." Style="{StaticResource SettingHint}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="Önbelleği temizle" Click="OnClearCache" Margin="0,0,8,8"
                                        ToolTip="Kayıtlı kanal listelerini ve yayın rehberlerini siler" />
                                <Button Content="Günlük klasörünü aç" Click="OnOpenLogs" Margin="0,0,8,8" ToolTip="Hata günlüklerinin bulunduğu klasörü açar" />
                            </WrapPanel>
                            <TextBlock x:Name="MaintenanceStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Vazgeç" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Click="OnSave" IsDefault="True">
                        <TextBlock Text="Kaydet" Foreground="{StaticResource Ink}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
